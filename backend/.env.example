# Copy to backend/.env and adjust. All keys are optional.

CHERUBYTE_PORT=1001
CHERUBYTE_HOST=0.0.0.0

# Leave blank to auto-detect from the primary interface.
CHERUBYTE_SUBNET=
CHERUBYTE_INTERFACE=

# Tamanho máximo de um upload de imagem (fotos de dispositivos, logos).
CHERUBYTE_MAX_UPLOAD_BYTES=5242880
# Origens do browser autorizadas a chamar a API, separadas por vírgula. Vazio
# está certo nos dois cenários suportados: em produção o SPA é servido desta
# mesma origem, e em dev o Vite faz proxy de /api server-side. Só precisas
# disto se acederes ao Vite a partir de outra máquina.
CHERUBYTE_CORS_ORIGINS=

CHERUBYTE_SCAN_INTERVAL_SECONDS=60
CHERUBYTE_OFFLINE_AFTER_SECONDS=180

# Cadência de identificação (o trabalho caro de cada ciclo).
# 0 = identificar tudo em todos os ciclos, como era antes.
CHERUBYTE_IDENTIFY_INTERVAL_SECONDS=900
CHERUBYTE_IDENTIFY_BATCH=16
CHERUBYTE_FULL_SWEEP_INTERVAL_SECONDS=900
CHERUBYTE_PORT_PROBE_CONCURRENCY=256

# Dias de histórico (eventos e ligações) a manter. 0 = manter tudo.
CHERUBYTE_RETENTION_DAYS=90
# Silêncio entre notificações repetidas do mesmo dispositivo. 0 = desligado.
CHERUBYTE_NOTIFY_COOLDOWN_SECONDS=900

# Telegram notifications (also settable from the Settings page)
CHERUBYTE_TELEGRAM_BOT_TOKEN=
CHERUBYTE_TELEGRAM_CHAT_ID=

# ntfy notifications (também configuráveis na página de Definições)
CHERUBYTE_NTFY_ENABLED=true
CHERUBYTE_NTFY_SERVER=https://ntfy.sh
CHERUBYTE_NTFY_TOPIC=
# Autenticação opcional: token de acesso, ou utilizador + password.
CHERUBYTE_NTFY_TOKEN=
CHERUBYTE_NTFY_USERNAME=
CHERUBYTE_NTFY_PASSWORD=
CHERUBYTE_NTFY_PRIORITY=3

# Email / SMTP notifications (também configuráveis na página de Definições)
CHERUBYTE_SMTP_ENABLED=true
CHERUBYTE_SMTP_HOST=
CHERUBYTE_SMTP_PORT=587
# starttls (587) | ssl (465) | none (25)
CHERUBYTE_SMTP_SECURITY=starttls
CHERUBYTE_SMTP_USERNAME=
CHERUBYTE_SMTP_PASSWORD=
# Vazio = usa o utilizador. Um ou mais destinatários, separados por vírgulas.
CHERUBYTE_SMTP_FROM=
CHERUBYTE_SMTP_TO=

# Web Push (notificações do browser, sem terceiros). A chave VAPID é gerada no
# 1º arranque e guardada na BD. vapid_subject: mailto: ou https: — vazio usa o
# public_base_url.
CHERUBYTE_WEBPUSH_ENABLED=true
CHERUBYTE_VAPID_SUBJECT=

# --- Alertas -----------------------------------------------------------------
# Política por tipo de evento (JSON); vazio = usa os valores por omissão.
CHERUBYTE_ALERT_POLICY=
# Janela de silêncio local, HH:MM. Alertas urgentes ignoram-na.
CHERUBYTE_QUIET_HOURS_START=
CHERUBYTE_QUIET_HOURS_END=
# Um agente ativo sem reportar há este tempo gera um alerta agent_offline
# (e agent_online quando volta). 0 desliga; o mínimo efetivo é 120s.
CHERUBYTE_AGENT_OFFLINE_AFTER_SECONDS=600
# URL alcançável do telemóvel, para os botões nas notificações ntfy.
CHERUBYTE_PUBLIC_BASE_URL=
# IPs/MACs (separados por vírgula) de servidores DHCP legítimos além do gateway.
# Qualquer outro servidor a responder DHCP na LAN gera um alerta rogue_dhcp.
CHERUBYTE_DHCP_ALLOWLIST=
# Portas (separadas por vírgula) a deixar de fora da watchlist de portas
# sensíveis — ex.: uma partilha SMB que corres de propósito.
CHERUBYTE_RISKY_PORTS_IGNORE=

# --- SNMP (opt-in) ---------------------------------------------------------
# Lê sysDescr (nome de switches/routers geridos) e a LLDP-MIB (ligações entre
# eles). Precisa do net-snmp instalado e de algo que responda.
CHERUBYTE_ENABLE_SNMP=false
CHERUBYTE_SNMP_COMMUNITY=public

# --- Home Assistant / MQTT ---------------------------------------------------
CHERUBYTE_MQTT_ENABLED=false
CHERUBYTE_MQTT_HOST=
CHERUBYTE_MQTT_PORT=1883
CHERUBYTE_MQTT_USERNAME=
CHERUBYTE_MQTT_PASSWORD=
CHERUBYTE_MQTT_BASE_TOPIC=cherubyte
CHERUBYTE_MQTT_DISCOVERY_PREFIX=homeassistant

# --- Prometheus metrics ----------------------------------------------------
CHERUBYTE_METRICS_ENABLED=true
# Empty: /api/metrics is open on the LAN. Set: require it as a Bearer header
# or ?token= query param.
CHERUBYTE_METRICS_TOKEN=

# --- Internet e resumo semanal -----------------------------------------------
CHERUBYTE_WAN_ENABLED=true
CHERUBYTE_WAN_TARGET=1.1.1.1
CHERUBYTE_WAN_INTERVAL_SECONDS=60
CHERUBYTE_WEEKLY_SUMMARY_ENABLED=false
CHERUBYTE_WEEKLY_SUMMARY_WEEKDAY=0
CHERUBYTE_WEEKLY_SUMMARY_HOUR=9
