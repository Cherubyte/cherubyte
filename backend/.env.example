# Copy to backend/.env and adjust. All keys are optional.

NETSCAN_PORT=1001
NETSCAN_HOST=0.0.0.0

# Leave blank to auto-detect from the primary interface.
NETSCAN_SUBNET=
NETSCAN_INTERFACE=

# Tamanho máximo de um upload de imagem (fotos de dispositivos, logos).
NETSCAN_MAX_UPLOAD_BYTES=5242880
# Origens do browser autorizadas a chamar a API, separadas por vírgula. Vazio
# está certo nos dois cenários suportados: em produção o SPA é servido desta
# mesma origem, e em dev o Vite faz proxy de /api server-side. Só precisas
# disto se acederes ao Vite a partir de outra máquina.
NETSCAN_CORS_ORIGINS=

NETSCAN_SCAN_INTERVAL_SECONDS=60
NETSCAN_OFFLINE_AFTER_SECONDS=180

# Cadência de identificação (o trabalho caro de cada ciclo).
# 0 = identificar tudo em todos os ciclos, como era antes.
NETSCAN_IDENTIFY_INTERVAL_SECONDS=900
NETSCAN_IDENTIFY_BATCH=16
NETSCAN_FULL_SWEEP_INTERVAL_SECONDS=900
NETSCAN_PORT_PROBE_CONCURRENCY=256

# Dias de histórico (eventos e ligações) a manter. 0 = manter tudo.
NETSCAN_RETENTION_DAYS=90
# Silêncio entre notificações repetidas do mesmo dispositivo. 0 = desligado.
NETSCAN_NOTIFY_COOLDOWN_SECONDS=900

# Telegram notifications (also settable from the Settings page)
NETSCAN_TELEGRAM_BOT_TOKEN=
NETSCAN_TELEGRAM_CHAT_ID=

# ntfy notifications (também configuráveis na página de Definições)
NETSCAN_NTFY_ENABLED=true
NETSCAN_NTFY_SERVER=https://ntfy.sh
NETSCAN_NTFY_TOPIC=
# Autenticação opcional: token de acesso, ou utilizador + password.
NETSCAN_NTFY_TOKEN=
NETSCAN_NTFY_USERNAME=
NETSCAN_NTFY_PASSWORD=
NETSCAN_NTFY_PRIORITY=3

# --- Alertas -----------------------------------------------------------------
# Política por tipo de evento (JSON); vazio = usa os valores por omissão.
NETSCAN_ALERT_POLICY=
# Janela de silêncio local, HH:MM. Alertas urgentes ignoram-na.
NETSCAN_QUIET_HOURS_START=
NETSCAN_QUIET_HOURS_END=
# URL alcançável do telemóvel, para os botões nas notificações ntfy.
NETSCAN_PUBLIC_BASE_URL=
# IPs/MACs (separados por vírgula) de servidores DHCP legítimos além do gateway.
# Qualquer outro servidor a responder DHCP na LAN gera um alerta rogue_dhcp.
NETSCAN_DHCP_ALLOWLIST=
# Portas (separadas por vírgula) a deixar de fora da watchlist de portas
# sensíveis — ex.: uma partilha SMB que corres de propósito.
NETSCAN_RISKY_PORTS_IGNORE=

# --- SNMP (opt-in) ---------------------------------------------------------
# Lê sysDescr (nome de switches/routers geridos) e a LLDP-MIB (ligações entre
# eles). Precisa do net-snmp instalado e de algo que responda.
NETSCAN_ENABLE_SNMP=false
NETSCAN_SNMP_COMMUNITY=public

# --- Home Assistant / MQTT ---------------------------------------------------
NETSCAN_MQTT_ENABLED=false
NETSCAN_MQTT_HOST=
NETSCAN_MQTT_PORT=1883
NETSCAN_MQTT_USERNAME=
NETSCAN_MQTT_PASSWORD=
NETSCAN_MQTT_BASE_TOPIC=netscan
NETSCAN_MQTT_DISCOVERY_PREFIX=homeassistant

# --- Prometheus metrics ----------------------------------------------------
NETSCAN_METRICS_ENABLED=true
# Empty: /api/metrics is open on the LAN. Set: require it as a Bearer header
# or ?token= query param.
NETSCAN_METRICS_TOKEN=

# --- Internet e resumo semanal -----------------------------------------------
NETSCAN_WAN_ENABLED=true
NETSCAN_WAN_TARGET=1.1.1.1
NETSCAN_WAN_INTERVAL_SECONDS=60
NETSCAN_WEEKLY_SUMMARY_ENABLED=false
NETSCAN_WEEKLY_SUMMARY_WEEKDAY=0
NETSCAN_WEEKLY_SUMMARY_HOUR=9
