{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cherubyte-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // A *.workers.dev hostname is a second front door with no Access in front of
  // it — the same Worker and the same signup table, reachable by anyone who
  // guesses the subdomain. The admin area is gated by hostname-bound Access
  // applications, so this is not optional.
  "workers_dev": false,
  // Set this to the domain you serve the site from before deploying.
  "routes": [{ "pattern": "cherubyte.example.com", "custom_domain": true }],

  "vars": {
    // The Access team domain. AUD and the allowlist are secrets — see README.
    "ACCESS_TEAM_DOMAIN": "",
    "AGENT_RELEASES_URL": "https://github.com/Cherubyte/cherubyte/releases/latest"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cherubyte-site",
      "database_id": "PLACEHOLDER-run-wrangler-d1-create-first"
    }
  ],

  "observability": { "enabled": true }
}
