[Unit]
Description=NetScan agent — local network sweep
Documentation=https://github.com/nobrega8/netscan
After=network-online.target
Wants=network-online.target
# An always-on monitor should never sit dead because it restarted a few times
# in quick succession — keep trying rather than give up.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/netscan-agent
# Configuration lives in a file, not here: the same mechanism as the Windows and
# macOS installers, and it keeps the enrolment token out of `systemctl cat`.
EnvironmentFile=-/etc/netscan-agent/agent.env

# `always`, not `on-failure`: a monitor that stops sweeping is useless, so it
# comes back from a crash, an OOM kill or a stray signal too. Only an explicit
# `systemctl stop` keeps it down.
Restart=always
RestartSec=3

# Raw sockets for the ARP sweep (scapy) and the DHCP sniffer. Running as root
# but dropping everything else: the agent reads no files it did not write and
# makes only outbound HTTP.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/netscan-agent
StateDirectory=netscan-agent

[Install]
WantedBy=multi-user.target
