[Unit]
Description=NetScan agent — varrimento da rede local
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __NETSCAN_USER__ / __NETSCAN_ROOT__ are filled in by
# scripts/install-agent-service.sh (it seds in the invoking user and repo path).
User=__NETSCAN_USER__
WorkingDirectory=__NETSCAN_ROOT__/agent
ExecStart=__NETSCAN_ROOT__/agent/.venv/bin/python run.py
Restart=on-failure
RestartSec=3

# O agente precisa de raw sockets para o varrimento ARP (scapy) e para o
# sniffer de DHCP; CAP_NET_BIND_SERVICE para o bind na porta de saúde 1002.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
