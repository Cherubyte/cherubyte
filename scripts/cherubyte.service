[Unit]
Description=Cherubyte — monitorização de dispositivos em rede
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# The USER and ROOT placeholders below are filled in by scripts/setup.sh and
# scripts/install-service.sh (they sed in the invoking user and the repo path).
User=__CHERUBYTE_USER__
WorkingDirectory=__CHERUBYTE_ROOT__/backend
ExecStart=__CHERUBYTE_ROOT__/backend/.venv/bin/python run.py
# `always`, not `on-failure`: the panel is the always-on half — bring it back
# from a crash or a stray signal, not only from a non-zero exit.
Restart=always
RestartSec=3

# The panel scans nothing — that is the agent's job, in its own process. The
# only privilege it needs is to bind the privileged port 1001.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
